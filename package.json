{
  "name": "pi-harness-personal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi harness. Notion, web search, local files, subagents, browser, GitHub, and a Notion vault.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typebox": "1.3.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-personal-harness/extensions/session.ts",
      "./packages/pi-personal-harness/extensions/vault.ts",
      "./packages/pi-personal-harness/extensions/loop.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
